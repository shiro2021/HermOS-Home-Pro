# HermOS theme — "Shiro"
# Geometry is authored against the 1536x1024 concept sheet and stored in
# 1/10000 of the screen (scale: 10000), so it is resolution independent.
theme
+ name: Shiro
+ scale: 10000
+ colors
  glass: 13,15,17,220
  active: 240,183,115,255
  inactive: 240,183,115,255
  paused: 150,150,150,255
+ layout
  + slot
    id: 0
    x: 143
    y: 5420
    w: 3288
    h: 2393
    chamfer: 13
  + slot
    id: 1
    x: 3613
    y: 5469
    w: 2930
    h: 2354
    chamfer: 13
  + slot
    id: 2
    x: 6934
    y: 5488
    w: 2930
    h: 2354
    chamfer: 13
  + slot
    id: 3
    x: 78
    y: 7959
    w: 3678
    h: 2012
    chamfer: 13
  + slot
    id: 4
    x: 3932
    y: 7959
    w: 2422
    h: 1992
    chamfer: 13
  + slot
    id: 5
    x: 6517
    y: 7949
    w: 3327
    h: 2021
    chamfer: 13
+ sidebar
  x: 7682
  y: 0
  w: 2318
  h: 5352
# Shiro Command Bar. x/w are fractions of the screen width, everything else of the
# screen height (scale: 10000). The bar height is ImGui's frame height:
#   height = font + 2 * pad_y ; icon buttons = height - spacing ; text is centred
#   on the line box (ascent - descent) inside the frame.
+ commandbar
  x: 1868
  y: 2900
  w: 3411
  font: 127
  pad_x: 234
  pad_y: 205
  spacing: 98
  tip: 244
  greet_font: 322
  sub_font: 154
# Where a newly launched app Cell opens (1/10000 of the screen; cascade steps each
# further Cell down and to the right by this fraction of the screen height).
+ appcell
  x: 500
  y: 3900
  w: 6300
  h: 5200
  cascade: 300
# Cell frame look. Lengths are 1/10000 of the screen height (16 = a 1.6 px border on a
# 1024 px screen); alpha is a percentage; colours are R,G,B. Only the active Cell glows;
# inactive Cells get the carbon gray border and a soft drop shadow.
+ frame
  border: 16
  glow_reach: 160
  glow_sigma: 55
  glow_alpha: 58
  shadow_reach: 80
  shadow_sigma: 30
  shadow_alpha: 38
  glow: 255,112,22
  active_a: 255,200,126
  active_b: 226,92,20
  carbon_a: 92,96,102
  carbon_b: 48,51,56
# OS-wide ink. Every accent-coloured (orange family) pixel is painted with `accent` when its
# element is active and with `carbon` (a gray) when it is inactive; brightness is kept.
# Bright neutral pixels (text, lines) of an inactive element move carbon_dim percent toward
# carbon_text. Pictures (wallpaper, photos, logos) are never recoloured.
+ ink
  accent: 255,156,48
  carbon: 138,143,150
  carbon_text: 168,172,178
  carbon_dim: 40
# Plasma-style panels. mode: visible | autohide | hidden. size is in design px.
# Users change these at runtime with Meta+L (left dock) and Meta+B (bottom bar).
+ panels
  + left
    mode: autohide
    size: 78
  + bottom
    mode: visible
    size: 28
