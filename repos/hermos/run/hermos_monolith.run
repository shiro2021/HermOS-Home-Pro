#
# HermOS v18 — monolithic desktop (desktop_builder)
#
# No Nitpicker, no Capture, no GUI server. hermos_fb maps the boot framebuffer
# straight to the screen and desktop_builder paints the octagonal Cells into it.
#
# Phase 1b: input. The drivers subsystem (depot drivers_interactive_pkg) brings
# up acpi -> pci_decode -> platform -> usb -> usb_hid, and usb_hid submits the
# keyboard/pointer event stream to event_to_input, which fans it out to the
# desktop_builder's Input session.
#

if {[have_include image/iso] || [have_include image/disk]} {
	proc boot_output { } { return "serial serial_fallback" }
}

assert {[have_recipe pkg/[drivers_interactive_pkg]]} \
	"Recipe for 'pkg/[drivers_interactive_pkg]' not available."

create_boot_directory

import_from_depot [depot_user]/pkg/[drivers_interactive_pkg] \
                  [depot_user]/pkg/terminal \
                  [depot_user]/src/init \
                  [depot_user]/src/bash \
                  [depot_user]/src/coreutils \
                  [depot_user]/src/vfs \
                  [depot_user]/src/vfs_pipe \
                  [depot_user]/src/vfs_report \
                  [depot_user]/src/fs_rom \
                  [depot_user]/src/posix

set hermos_build {
	core init lib/ld
	app/desktop_builder driver/framebuffer/hermos_fb
	app/hermes_agent_cpp
	app/mykee_router
	app/menu_view
	app/theme_engine
	app/bottom_dock
	app/agents_sidebar
	app/hermos_files
	lib/stdcxx lib/libc lib/vfs lib/libm
	lib/libpng lib/blit lib/file
	server/nic_router driver/nic lib/vfs_lwip lib/vfs_jitterentropy lib/curl lib/libssh lib/libssl lib/libcrypto lib/zlib
	server/event_to_input server/report_rom timer
	driver/rtc
	driver/ahci
	driver/nvme
	server/part_block lib/vfs_rump server/tar_rom
	test/nitpicker
}
set brain_model [cmd_arg --hermos-brain-model ""]
if {$brain_model ne ""} { lappend hermos_build app/shiro_brain lib/llama }
build $hermos_build

set hermos_config {
config
+ parent-provides
  + service ROM
  + service CPU
  + service RM
  + service PD
  + service LOG
  + service IO_MEM
  + service IO_PORT
  + service IRQ
  + service Rtc

+ default-route | + any-service | + parent
+ default | caps: 100 | ram: 2M

+ start timer
  + provides | + service Timer
  + route | + any-service | + parent

+ start hermos_fb | ram: 8M
  + provides | + service Framebuffer
  + route
    + any-service | + parent

+ start event_to_input | caps: 160 | ram: 4M
  + provides
    + service Event
    + service Input
  + route
    + any-service | + parent

+ start pc_rtc | caps: 100 | ram: 2M
  + provides | + service Rtc
  + route
    + service IO_PORT | + parent
    + any-service | + parent

+ start drivers | caps: 2500 | ram: 160M | managing_system: yes
  + binary init
  + provides | + service Block
  + route
    + service ROM | label: config | + parent | label: hermos_drivers.config
    + service ROM | label: platform -> system | + child report_rom
    + service Report | + child report_rom
    + service Timer | + child timer
    + service Event | + child event_to_input
    + service Uplink | + child nic_router
    + any-service   | + parent

+ start nic_router | caps: 200 | ram: 10M
  + provides
    + service Nic
    + service Uplink
  + config | verbose_domain_state: yes
    + policy | label_prefix: hermes_agent | domain: downlink
    + policy | label_prefix: mykee_router | domain: downlink
@BROWSER_NIC@
    + policy | label_prefix: drivers | domain: uplink
    + domain uplink
      + nat | domain: downlink | tcp-ports: 16384 | udp-ports: 16384 | icmp-ids: 16384
    + domain downlink | interface: 10.0.3.1/24
      + dhcp-server | ip_first: 10.0.3.2 | ip_last: 10.0.3.9 | dns_config_from: uplink
      + tcp | dst: 0.0.0.0/0 | + permit-any | domain: uplink
      + udp | dst: 0.0.0.0/0 | + permit-any | domain: uplink
      + icmp | dst: 0.0.0.0/0 | domain: uplink
  + route
    + service Timer | + child timer
    + any-service | + parent

+ start report_rom | ram: 2M
  + provides
    + service Report
    + service ROM
  + config | verbose: yes
    + policy | label: apps -> config | report: desktop_builder -> apps
    + policy | label: apps -> state  | report: apps -> state
@BROWSER_REPORT@
    + policy | label: hermes_agent -> ui_intent     | report: desktop_builder -> ui_intent
    + policy | label: desktop_builder -> ai_command | report: hermes_agent -> ai_command
    + policy | label: mykee_router -> mykee_request   | report: hermes_agent -> mykee_request
@BRAIN_POLICY@
    + policy | label: hermes_agent -> mykee_response  | report: mykee_router -> mykee_response
    + policy | label: desktop_builder -> theme_state | report: desktop_builder -> theme_state
    + policy | label: desktop_builder -> ahci_ports | report: drivers -> ahci -> ports
    + policy | label: desktop_builder -> nvme_controller | report: drivers -> nvme -> controller
    + policy | label: drivers -> platform -> system | report: desktop_builder -> system
    + policy | label: theme_engine -> screen_state | report: desktop_builder -> screen_state
    + policy | label: desktop_builder -> dock_state | report: bottom_dock -> dock_state
  + route
    + any-service | + parent

+ start bottom_dock | caps: 200 | ram: 8M
  + route
    + service Input  | + child event_to_input
    + service Report | + child report_rom
    + any-service | + parent
  + config
    + dock | height: 100 | trigger: 2

+ start desktop_builder | caps: 1000 | ram: 96M
  + provides | + service Gui
  + route
    + service Framebuffer | + child hermos_fb
    + service Input       | + child event_to_input
    + service Report      | + child report_rom
    + service ROM | label: ai_command | + child report_rom
    + service ROM | label: theme_state | + child report_rom
    + service ROM | label: dock_state | + child report_rom
    + service ROM | label: ahci_ports | + child report_rom
    + service ROM | label: nvme_controller | + child report_rom
    + service Rtc         | + child pc_rtc
    + service Timer       | + child timer
    + service Block       | + child drivers
    + any-service         | + parent
  + config@DESKTOP_PREVIEW@
    + vfs
      + dir dev
        + log
        + null
      + dir assets
        + rom Roboto-Regular.ttf
        + rom Inter-Regular.ttf
        + rom Inter-Medium.ttf
        + rom Inter-SemiBold.ttf
        + rom compass.png
        + rom hydro_thumb.png
        + rom hydro_big.png
        + rom icon_search.png
        + rom icon_folder.png
        + rom icon_mic.png
        + rom icon_user.png
        + rom icon_terminal.png
        + rom icon_close.png
        + rom icon_minimize.png
        + rom icon_pause.png
        + rom wallpaper.png
        + rom logo.png
        + rom icon_leaf.png
      + dir apps
        + rom registry
      + dir install
        + rom hermos-system.img

+ start hermes_agent | caps: 1500 | ram: 64M
  + binary hermes_agent_cpp
  + route
    + service ROM | label: ui_intent | + child report_rom
    + service ROM | label: mykee_response | + child report_rom
    + service Report | + child report_rom
    + service ROM | label_suffix: .lib.so | + parent
    + service Timer | + child timer
    + service Nic | + child nic_router
    + service Rtc | + child pc_rtc
    + any-service | + parent
  + config
    + libc | stdout: /dev/log | stderr: /dev/log | socket: /socket | pipe: /pipe | rtc: /dev/rtc
    + vfs
      + dir dev
        + log
        + null
        + rtc
      + dir socket
        + lwip | dhcp: yes
      + dir pipe
        + pipe
      + dir ui
        + rom | name: ui_intent | label: ui_intent | binary: no
      + dir ai
        + report | name: ai_command | label: ai_command | buffer: 4096
      + dir mykee
        + report | name: mykee_request | label: mykee_request | buffer: 8192
        + rom | name: mykee_response | label: mykee_response | binary: no
      + dir corpus
        + rom | name: shiro_corpus.txt | binary: no

# The MyKee router is the only component that holds the AI key and speaks TLS to the AI service:
# it verifies the server certificate (CA bundle), needs a real entropy source, and is not the
# component that serves the :80 status page.
+ start mykee_router | caps: 1500 | ram: 64M
  + binary mykee_router
  + route
    + service ROM | label: mykee_request | + child report_rom
@BRAIN_ROUTER_ROUTE@
    + service Report | + child report_rom
    + service ROM | label_suffix: .lib.so | + parent
    + service Timer | + child timer
    + service Nic | + child nic_router
    + service Rtc | + child pc_rtc
    + any-service | + parent
  + config
    + libc | stdout: /dev/log | stderr: /dev/log | socket: /socket | rng: /dev/random | pipe: /pipe | rtc: /dev/rtc
    + vfs
      + dir dev
        + log
        + null
        + rtc
        + jitterentropy | name: random
      + dir socket
        + lwip | dhcp: yes
      + dir pipe
        + pipe
      + dir etc
        + dir ssl
          + rom | name: ca-bundle.crt | binary: no
      + dir config
        + inline mykee.conf | : {"routes":[@MYKEE_LOCAL_ROUTE@{"name":"master-proxy","url":"https://api.deepseek.com/chat/completions","model":"deepseek-chat"}]}
      + dir ai
        + rom | name: mykee.key | binary: no
      + dir mykee
        + rom | name: mykee_request | label: mykee_request | binary: no
        + report | name: mykee_response | label: mykee_response | buffer: 8192
@BRAIN_ROUTER_VFS@

@BRAIN_CHILD@

+ start apps | caps: 6000 | ram: 256M
  + binary init
  + route
    + service Block | + child drivers
    + service ROM | label: config | + child report_rom
    + service Report | + child report_rom
    + service Timer | + child timer
    + service Gui | + child desktop_builder
    + service Rtc | + child pc_rtc
    + any-service | + parent
@BROWSER_CHILD@
-
}

#
# The HermOS Browser (optional while it is being brought up): with --hermos-browser-dir DIR (the output of
# tools/hermos-browser/assemble-modules.sh) its program and libraries become boot modules and it starts as the
# LAST top-level child. Its RAM is deliberately oversized: init gives a child whose quota exceeds what is left
# all of the remainder, so the browser takes what the machine can spare instead of a number picked here.
# The child is named app2: the Gui server places a client in the Cell whose number is in its child name.
#
set browser_dir [cmd_arg --hermos-browser-dir ""]
set browser_child ""
set browser_nic ""
set browser_report ""
set desktop_preview " | preview: yes"
if {$browser_dir ne ""} {
	set desktop_preview " | preview: yes"
	set browser_nic "    + policy | label_prefix: app2 | domain: downlink"
	set browser_report "    + policy | label: app2 -> shape | report: app2 -> shape"
	set browser_child {
+ start browser_rom | caps: 200 | ram: 900M
  + binary tar_rom
  + provides | + service ROM
  + config | + archive | name: browser.tar
  + route
    + service ROM | label: browser.tar | + parent
    + any-service | + parent

+ start app2 | caps: 10000 | ram: 64G
  + binary hermos_browser
  + route
    + service Nic   | + child nic_router
    + service Gui   | + child desktop_builder
    + service Rtc   | + child pc_rtc
    + service Timer | + child timer
    + service Report | + child report_rom
    + service ROM | label_last: ld.lib.so | + parent
    + service ROM | + child browser_rom
    + any-service | + parent
  + config
    + vfs
      + dir dev
        + dir pipe
          + pipe
        + log
        + jitterentropy | name: entropy
        + xoroshiro | name: random  | seed_path: /dev/entropy
        + xoroshiro | name: urandom | seed_path: /dev/entropy
        + rtc
      + dir shm
        + qtwebengine_shm
      + dir socket
        + lwip | dhcp: yes
      + dir tmp
        + ram
      + dir .config
        + ram
      + dir downloads
        + ram
      + tar | name: qt6_dejavusans.tar
      + tar | name: qt6_libqgenode.tar
      + tar | name: qt6_libqjpeg.tar
      + tar | name: qt6_libqsqlite.tar
      + tar | name: qt6_webengine_resources.tar
      + tar | name: qt6_webengine_translations.tar
      + ram
    + libc | stdout: /dev/log | stderr: /dev/log | pipe: /dev/pipe | rtc: /dev/rtc | socket: /socket | pid: 1
      + mmap | align_log2: 21
    + arg | value: hermos_browser
    + env | name: QTWEBENGINE_CHROMIUM_FLAGS | value: --single-process --no-sandbox --disable-gpu --disable-gpu-shader-disk-cache --disable-dev-shm-usage
    + env | name: QT_QPA_PLATFORM | value: genode
}
}
#
# Shiro Brain (local model). Only when a GGUF file is given with --hermos-brain-model: the model is a boot
# module, the component gets its size plus room for the context, and MyKee tries the local route first.
#
set brain_extra_vfs ""; set brain_child ""; set brain_policy ""; set brain_route ""; set brain_vfs ""; set brain_local_route ""
if {$brain_model ne ""} {
	# optional text files next to the model: X.gguf, X.prompt (format with {}), X.system (said first)
	set brain_base [file rootname $brain_model]
	foreach {ext name} {prompt prompt.txt system system.txt} {
		if {[file exists $brain_base.$ext]} { append brain_extra_vfs "        + rom | name: $name | label: shiro.$ext | binary: no\n" }
	}
	set brain_ram [expr {[file size $brain_model] / 1048576 + 640}]
	set brain_policy "    + policy | label: shiro_brain -> brain_request | report: mykee_router -> brain_request\n    + policy | label: mykee_router -> brain_response | report: shiro_brain -> brain_response"
	set brain_route "    + service ROM | label: brain_response | + child report_rom"
	set brain_vfs "      + dir brain\n        + report | name: brain_request | label: brain_request | buffer: 8192\n        + rom | name: brain_response | label: brain_response | binary: no"
	set brain_local_route {{"name":"shiro-local","url":"local://shiro"},}
	set brain_child_text "+ start shiro_brain | caps: 1500 | ram: ${brain_ram}M
  + binary shiro_brain
  + route
    + service ROM | label: brain_request | + child report_rom
    + service Report | + child report_rom
    + service ROM | label_suffix: .lib.so | + parent
    + service Timer | + child timer
    + any-service | + parent
  + config
    + libc | stdout: /dev/log | stderr: /dev/log | pipe: /pipe
    + vfs
      + dir dev
        + log
        + null
      + dir pipe
        + pipe
      + dir model
        + rom | name: shiro.gguf
@BRAIN_EXTRA_VFS@
      + dir brain
        + rom | name: request | label: brain_request | binary: no
        + report | name: response | label: brain_response | buffer: 16384
"
	set brain_child [string map [list @BRAIN_EXTRA_VFS@ [string trimright $brain_extra_vfs "\n"]] $brain_child_text]
}

install_config [string map [list @BROWSER_CHILD@ $browser_child @BROWSER_NIC@ $browser_nic \
                                 @BROWSER_REPORT@ $browser_report @DESKTOP_PREVIEW@ $desktop_preview \
                                 @BRAIN_POLICY@ $brain_policy @BRAIN_ROUTER_ROUTE@ $brain_route @BRAIN_ROUTER_VFS@ $brain_vfs \
                                 @MYKEE_LOCAL_ROUTE@ $brain_local_route @BRAIN_CHILD@ $brain_child @BRAIN_EXTRA_VFS@ $brain_extra_vfs] $hermos_config]

#
# drivers subsystem: the interactive driver stack without block/network.
# usb_hid submits its event stream straight to event_to_input (label "usb"),
# which turns it into an Input session for desktop_builder.
#
set drivers_config_fd [open "bin/hermos_drivers.config" "WRONLY CREAT TRUNC"]
puts $drivers_config_fd {
config
+ parent-provides
  + service IRQ
  + service IO_MEM
  + service IO_PORT
  + service ROM
  + service PD
  + service RM
  + service CPU
  + service LOG
  + service Timer
  + service Event
  + service Uplink
  + service Report

+ default | caps: 300 | ram: 32M

+ service Nic | + default-policy | + child nic
# The installer opens one Block session per disk it found in the reports,
# labelled ahci<port> / nvme<n>; each label has its own policy below.
+ service Block
  + policy | label_prefix: desktop_builder -> ahci | + child ahci
  + policy | label_prefix: desktop_builder -> nvme | + child nvme
  + policy | label_prefix: apps -> data_ahci | + child ahci
  + policy | label_prefix: apps -> data_nvme | + child nvme

+ start acpi | caps: 250 | ram: 4M
  + route
    + service IO_MEM | + parent
    + service LOG    | + parent
    + service PD     | + parent
    + service RM     | + parent
    + service CPU    | + parent
    + service ROM    | + parent
    + service Report | + child report_rom

+ start report_rom | caps: 100 | ram: 2M
  + provides
  | + service ROM
  | + service Report
  + config
  | + policy | label: pci_decode -> system | report: acpi -> acpi
  | + policy | label: platform -> devices  | report: pci_decode -> devices
  | + policy | label: usb_hid -> report    | report: usb -> devices
  + route
    + service LOG | + parent
    + service PD  | + parent
    + service CPU | + parent
    + service ROM | + parent

+ start pci_decode | caps: 100 | ram: 2M
  + route
    + service Report              | + child report_rom
    + service ROM | label: system | + child report_rom
    + service IO_MEM              | + parent
    + service LOG                 | + parent
    + service PD                  | + parent
    + service RM                  | + parent
    + service CPU                 | + parent
    + service ROM                 | + parent

+ start platform | caps: 200 | ram: 3M | managing_system: yes
  + provides
  | + service Dma
  | + service Platform
  + route
  | + service ROM | label: devices | + child report_rom
  | + service Report               | + child report_rom
  | + service IRQ                  | + parent
  | + service IO_MEM               | + parent
  | + service IO_PORT              | + parent
  | + service ROM                  | + parent
  | + service PD                   | + parent
  | + service CPU                  | + parent
  | + service LOG                  | + parent
  | + service Timer                | + parent
  + config
    + report | devices: yes
    + policy | label_prefix: usb | info: yes | + pci | class: USB
    + policy | label_prefix: nic | info: yes | + pci | class: ETHERNET
    + policy | label_prefix: ahci | + pci | class: AHCI
    + policy | label_prefix: nvme | + pci | class: NVME

+ start usb | caps: 200 | ram: 16M
  + binary pc_usb_host
  + provides | + service Usb
  + config | bios_handoff: no
  | + report | devices: yes
  | + policy | label_prefix: usb_hid | + device | class: 0x3
  + route
    + service Report | label: devices | + child report_rom
    + any-service
      + parent
      + any-child

+ start usb_hid | caps: 180 | ram: 10M
  + route
    + service ROM | label: report | + child report_rom
    + service Event | + parent | label: usb
    + service Usb   | + child usb
    + any-service
      + parent
      + any-child

+ start mac_report_rom
  + binary report_rom
  + provides
    + service ROM
    + service Report
  + config | verbose: yes
    + policy | label: nic -> devices | report: nic -> devices
  + route
    + service LOG | + parent
    + service PD  | + parent
    + service CPU | + parent
    + service ROM | + parent

+ start nic | caps: 250 | ram: 10M
  + binary ipxe_nic
  + route
    + service Dma      | + child platform
    + service Platform | + child platform
    + service ROM      | + parent
    + service PD       | + parent
    + service RM       | + parent
    + service CPU      | + parent
    + service LOG      | + parent
    + service Timer    | + parent
    + service Uplink   | + parent
    + service Report   | + child mac_report_rom
  + config
    + report | mac_address: yes

+ start ahci | caps: 200 | ram: 12M
  + provides | + service Block
  + config | atapi: no
    + report | ports: yes
    + policy | label: desktop_builder -> ahci0 | device: 0 | writeable: yes
    + policy | label: desktop_builder -> ahci1 | device: 1 | writeable: yes
    + policy | label: desktop_builder -> ahci2 | device: 2 | writeable: yes
    + policy | label: desktop_builder -> ahci3 | device: 3 | writeable: yes
    + policy | label: desktop_builder -> ahci4 | device: 4 | writeable: yes
    + policy | label: desktop_builder -> ahci5 | device: 5 | writeable: yes
    + policy | label: desktop_builder -> ahci6 | device: 6 | writeable: yes
    + policy | label: desktop_builder -> ahci7 | device: 7 | writeable: yes
    + policy | label: apps -> data_ahci0 | device: 0 | writeable: yes
    + policy | label: apps -> data_ahci1 | device: 1 | writeable: yes
    + policy | label: apps -> data_ahci2 | device: 2 | writeable: yes
    + policy | label: apps -> data_ahci3 | device: 3 | writeable: yes
    + policy | label: apps -> data_ahci4 | device: 4 | writeable: yes
    + policy | label: apps -> data_ahci5 | device: 5 | writeable: yes
    + policy | label: apps -> data_ahci6 | device: 6 | writeable: yes
    + policy | label: apps -> data_ahci7 | device: 7 | writeable: yes
  + route
    + service Dma      | + child platform
    + service Platform | + child platform
    + service Report   | + parent
    + any-service
      + parent
      + any-child

+ start nvme | caps: 200 | ram: 24M
  + provides | + service Block
  + config | max_hmb_size: 16M
    + report | namespaces: yes
    + policy | label: desktop_builder -> nvme0 | writeable: yes
    + policy | label: apps -> data_nvme0 | writeable: yes
  + route
    + service Dma      | + child platform
    + service Platform | + child platform
    + service Report   | + parent
    + any-service
      + parent
      + any-child
-
}
close $drivers_config_fd

# (terminal sandbox + apps.config removed — cells now boot empty and are
#  populated on demand by desktop_builder via its own apps report)

#
# HermOS terminal config: monospace font + an initial size that fits a Cell.
# (kept — referenced by desktop_builder's _emit_terminal_stack when the user
#  launches the Terminal app from the dock)
#
set term_config_fd [open "bin/hermos_terminal.config" "WRONLY CREAT TRUNC"]
puts $term_config_fd {
config
+ initial | width: 560 | height: 340
+ vfs
  + rom VeraMono.ttf
  + dir font
    + dir monospace
      + ttf regular | path: /VeraMono.ttf | size_px: 14
-
}
close $term_config_fd

# The C++ agent (hermes_agent_cpp) is built by the Genode build system and is
# included in build_artifacts; no manual copy is needed.

# The installer payload: a complete GPT system disk image of this composition
# (the output of an `image/disk` build of this same run script). A system-image
# build, or a build without --hermos-system-image, embeds a marked stub instead,
# and the installer then refuses to install.
set payload [cmd_arg --hermos-system-image ""]
if {$payload ne ""} {
	exec cp $payload bin/hermos-system.img
} else {
	exec sh -c "printf 'HERMOS-NO-INSTALLER-PAYLOAD' > bin/hermos-system.img"
}

# package the stb UI assets (font + icons) as ROMs mounted at /assets
set asset_dir [genode_dir]/repos/hermos/src/app/desktop_builder/assets
exec cp $asset_dir/Roboto-Regular.ttf bin/Roboto-Regular.ttf
foreach scene_asset {Inter-Regular.ttf Inter-Medium.ttf Inter-SemiBold.ttf compass.png hydro_thumb.png hydro_big.png} {
	exec cp $asset_dir/$scene_asset bin/$scene_asset
}
exec cp $asset_dir/search.png bin/icon_search.png
exec cp $asset_dir/folder.png bin/icon_folder.png
exec cp $asset_dir/mic.png bin/icon_mic.png
exec cp $asset_dir/user.png bin/icon_user.png
exec cp $asset_dir/terminal.png bin/icon_terminal.png
exec cp $asset_dir/icon_close.png bin/icon_close.png
exec cp $asset_dir/icon_minimize.png bin/icon_minimize.png
exec cp $asset_dir/icon_pause.png bin/icon_pause.png
exec cp $asset_dir/wallpaper.png bin/wallpaper.png
exec cp $asset_dir/logo.png bin/logo.png
exec cp $asset_dir/icon_leaf.png bin/icon_leaf.png
exec cp $asset_dir/apps.registry bin/registry
exec cp $asset_dir/files_menu.xml bin/files_menu
exec cp [genode_dir]/repos/hermos/src/app/theme_engine/theme.hid bin/theme.hid

#
# Secrets and trust roots are build inputs, never committed:
#  - the AI service key comes from the file named by HERMOS_MYKEE_KEY_FILE (empty = no AI);
#  - the TLS trust store is a CA bundle (HERMOS_CA_BUNDLE, default: the build host's), because
#    the agent verifies the server certificate of the AI service.
#
set key_src ""
if {[info exists ::env(HERMOS_MYKEE_KEY_FILE)]} { set key_src $::env(HERMOS_MYKEE_KEY_FILE) }
if {$key_src ne "" && [file exists $key_src]} {
	exec cp $key_src bin/mykee.key
} else {
	puts "NOTE: HERMOS_MYKEE_KEY_FILE not set: the image has no AI key (the agent will report that)"
	set kfd [open bin/mykee.key "WRONLY CREAT TRUNC"]; puts $kfd ""; close $kfd
}
set ca_src "/etc/ssl/certs/ca-certificates.crt"
if {[info exists ::env(HERMOS_CA_BUNDLE)]} { set ca_src $::env(HERMOS_CA_BUNDLE) }
if {![file exists $ca_src]} {
	puts stderr "ERROR: no CA bundle at $ca_src (set HERMOS_CA_BUNDLE); TLS verification needs one"
	exit 1
}
exec cp $ca_src bin/ca-bundle.crt

# Shiro Local Brain corpus: the HermOS docs (text only, no secrets live in doc/)
exec sh -c "cat [genode_dir]/repos/hermos/doc/*.md > bin/shiro_corpus.txt"

set boot_modules [list {*}[build_artifacts] hermos_drivers.config hermos_terminal.config Roboto-Regular.ttf Inter-Regular.ttf Inter-Medium.ttf Inter-SemiBold.ttf compass.png hydro_thumb.png hydro_big.png icon_search.png icon_folder.png icon_mic.png icon_user.png icon_terminal.png icon_close.png icon_minimize.png icon_pause.png wallpaper.png logo.png icon_leaf.png registry files_menu menu_view_style.tar theme.hid ca-bundle.crt mykee.key shiro_corpus.txt hermos-system.img]

# the browser's files (only when given)
if {$browser_dir ne ""} {
	foreach f [lsort [glob -directory $browser_dir *]] {
		set n [file tail $f]
		exec cp -f $f bin/$n
		lappend boot_modules $n
	}
}
if {$brain_model ne ""} {
	exec cp -f $brain_model bin/shiro.gguf
	lappend boot_modules shiro.gguf
	foreach ext {prompt system} {
		if {[file exists [file rootname $brain_model].$ext]} { exec cp -f [file rootname $brain_model].$ext bin/shiro.$ext; lappend boot_modules shiro.$ext }
	}
}
build_boot_image $boot_modules

if {[cmd_arg --hermos-build-only no] eq "yes"} {
	puts "HermOS monolith image built; QEMU skipped by --hermos-build-only"
} else {
	run_genode_until forever
}
